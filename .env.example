BL_WORKSPACE=
BL_API_KEY=
BL_REGION=us-pdx-1
# Optional quickstart overrides. Leave empty to use the documented defaults.
BL_QUICKSTART_SANDBOX=
BL_QUICKSTART_IMAGE=
BL_SANDBOX_IMAGE=
BL_SANDBOX_IDLE_TTL=7d
# Optional total maximum lifetime. Leave empty to avoid deleting active work by age.
BL_SANDBOX_MAX_AGE=
BL_SESSION_MINUTES=10
BL_SESSION_RENEWAL_SECONDS=60
BL_STANDBY_WAIT_MS=20000
# Private previews are the working default. Set true only for a reviewed public fixture.
BL_PREVIEW_PUBLIC=false
# Optional public-preview domain control. This Blaxel capability is in public preview.
BL_SANDBOX_ALLOWED_DOMAINS=
