{
  "name": "@blaxel-ai/blaxel-sandbox-code-generation-cookbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Reference lifecycle for building, checking, repairing, and previewing generated code in Blaxel Sandboxes.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blaxel-ai/blaxel-sandbox-code-generation-cookbook.git"
  },
  "homepage": "https://github.com/blaxel-ai/blaxel-sandbox-code-generation-cookbook#readme",
  "bugs": {
    "url": "https://github.com/blaxel-ai/blaxel-sandbox-code-generation-cookbook/issues"
  },
  "files": [
    ".env.example",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "docs",
    "examples/*.ts",
    "examples/web/index.html",
    "examples/web/src",
    "examples/web/vite.config.ts",
    "fixtures/broken-component/index.html",
    "fixtures/broken-component/package.json",
    "fixtures/broken-component/package-lock.json",
    "fixtures/broken-component/src",
    "fixtures/broken-component/tsconfig.json",
    "fixtures/broken-component/vite.config.ts",
    "fixtures/updated-component/src",
    "fixtures/valid-component/src",
    "images",
    "scripts",
    "src",
    "tests",
    "verification",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "quickstart": "tsx examples/quickstart.ts",
    "example": "tsx examples/run.ts",
    "example:web": "vite --config examples/web/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live:quickstart": "RUN_BLAXEL_QUICKSTART_TESTS=1 vitest run tests/quickstart.live.test.ts",
    "test:live": "RUN_BLAXEL_LIVE_TESTS=1 vitest run tests/live.test.ts",
    "test:live:image": "RUN_BLAXEL_IMAGE_TESTS=1 vitest run tests/live-image.test.ts"
  },
  "dependencies": {
    "@blaxel/core": "0.3.11",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "^26.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "fast-uri": "3.1.7",
    "qs": "6.16.0",
    "toml": "4.2.0"
  }
}
